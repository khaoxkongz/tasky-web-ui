{
  "name": "tasky-web-ui",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @tasky-web-ui/db",
    "db:studio": "turbo run db:studio -F @tasky-web-ui/db",
    "db:generate": "turbo run db:generate -F @tasky-web-ui/db",
    "db:migrate": "turbo run db:migrate -F @tasky-web-ui/db",
    "db:start": "turbo run db:start -F @tasky-web-ui/db",
    "db:watch": "turbo run db:watch -F @tasky-web-ui/db",
    "db:stop": "turbo run db:stop -F @tasky-web-ui/db",
    "db:down": "turbo run db:down -F @tasky-web-ui/db",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@tasky-web-ui/env": "workspace:*"
  },
  "devDependencies": {
    "@tasky-web-ui/config": "workspace:*",
    "@types/bun": "^1.3.4",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "turbo": "^2.10.4",
    "typescript": "^7.0.1-rc",
    "ultracite": "^7.9.4"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "next-themes": "^0.4.6",
      "lucide-react": "^1.21.0",
      "tailwindcss": "^4.3.1",
      "dotenv": "^17.4.2",
      "typescript": "^6",
      "zod": "^4.1.13",
      "hono": "^4.8.2",
      "sonner": "^2.0.7",
      "drizzle-kit": "^1.0.0-rc.4-ca0f029",
      "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
      "@orpc/server": "^1.14.6",
      "@orpc/openapi": "^1.14.6",
      "@orpc/zod": "^1.14.6",
      "@orpc/client": "^1.14.6",
      "@types/bun": "^1.3.4",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  }
}
